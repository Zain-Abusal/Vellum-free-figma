# Live collaboration storage (Upstash Redis). On Vercel these are added automatically when you
# connect "Upstash for Redis" from the Marketplace (Storage tab). Either naming works:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Without them, /api uses an in-memory store (fine for local dev, NOT for production).
